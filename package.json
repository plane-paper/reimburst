{
  "name": "reimburse",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "env -u NODE_OPTIONS sh -c 'cd apps/web && ./node_modules/.bin/next dev --webpack -p 3000'",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "contract:generate": "uv run --package api python apps/api/scripts/export_openapi.py && pnpm --filter @reimburse/contract generate"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  }
}
